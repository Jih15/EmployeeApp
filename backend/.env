# App
APP_NAME="Employee Management API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Database (wajib)
DATABASE_URL=postgresql+asyncpg://postgres:Admin1234@localhost:5432/employee_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security (wajib)
SECRET_KEY=569214ccb6170b6b07e5272ae5651d7f9aa7bd32d6c1f9ff37790b1cde4297c8
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000"]
ALLOWED_HOSTS=["*"]

# File Upload
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPE=["image/jpeg","image/png","image/webp"]
UPLOAD_DIR=uploads

# Face Recognition
FACE_RECOGNITION_TOLERANCE=0.5
FACE_RECOGNITION_MODEL=hog

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10